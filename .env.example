# ==============================================================================
# BERMUDA PORTAL - SEENODE CLOUD GATEWAY ENVIRONMENT TEMPLATE
# Platform: Seenode PaaS (UpCloud Frankfurt de-fra1) + Cloudflare Edge
# ==============================================================================

# [Recommended for Edge Tuning] Cloudflare API Token with Zone/DNS/Ruleset Edit permissions
CLOUDFLARE_API_TOKEN=

# [Optional] Explicit Cloudflare Zone ID (Auto-discovered if left empty)
CLOUDFLARE_ZONE_ID=

# [Recommended for Auto-Provisioning] Seenode API Token (from https://seenode.com/dashboard/user#api)
SEENODE_API_TOKEN=

# [Optional] Explicit Seenode Application ID (Auto-discovered via API if left empty)
SEENODE_APPLICATION_ID=

# [Optional] Custom Domain routed through Cloudflare Edge (e.g. sub.yourdomain.com or DigitalPlat domain)
CUSTOM_DOMAIN=

# [Optional] Master Secret Seed for Deterministic Key Derivation (Auto-generated & persisted if empty)
BERMUDA_MASTER_KEY=

# [Optional] Seenode Deployment Region (de-fra1, fi-hel1, europe-west4, us-east4, us-west, asia-southeast1)
BERMUDA_REGION=de-fra1
